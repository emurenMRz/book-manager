{
	"compilerOptions": {
		"sourceMap": true,
		"target": "ES2015",
		"module": "ES2015",
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"importHelpers": false,
		"types": [
			"vite/client"
		],
		"lib": [
			"ESNext",
			"DOM"
		]
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		"dist",
		"vite.config.ts"
	]
}